#!/usr/bin/make -f

ifneq ($(filter pkg.majoris-image.gainmap,$(DEB_BUILD_PROFILES)),)
gainmap = enabled
else
gainmap = disabled
endif

ifneq ($(filter pkg.majoris-image.nosequence,$(DEB_BUILD_PROFILES)),)
sequence = disabled
else
sequence = enabled
endif

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- -Dglycin=enabled -Dintrospection=enabled -Dultrahdr=$(gainmap) -Dsequence=$(sequence)
